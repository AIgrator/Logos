# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Linter caches (rewritten on every ruff run — must not trigger reindex)
.ruff_cache/

# Packaging artifacts (PyInstaller work dir, Logos.exe, LogosSetup.exe)
build/
dist/

# Virtual Environments
.venv/
venv/
ENV/

# IDE / Editor specific
.vscode/
.idea/

# OS-specific
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
screenshots/

# Local user data (created on first run; holds machine-specific paths)
settings.json
settings.json.bak

# Ignore all files in logs directory
logs/

# Ignore all files in cache directory
cache/

tests/

# OmniParser model files
models/

# Ignore content of any 'old' directory
**/old/

update_models.py
